# Copy to .env and fill in. Never commit .env.
ENV=dev
APP_ORIGIN=http://localhost:8000
ALLOWED_EMAILS=you@example.com,brother@example.com
# true: any Google account can sign in as a guest; guests must add their own OpenRouter key
OPEN_SIGNUP=false
# Who sees hosting limits, consoles and the app key credit in Settings → Admin
ADMIN_EMAILS=you@example.com

# Neon branch "dev": pooled for the app, unpooled for migrations (`neon env pull` fills these)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

OPENROUTER_API_KEY=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=dev

FIREBASE_PROJECT_ID=daily-coach-af64d
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=daily-coach-af64d.firebaseapp.com
FIREBASE_APP_ID=

# Local scripts only; in the app each user connects intervals.icu in Settings
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=
