#!/usr/bin/env bash
# Store one prod secret in Google Secret Manager (project daily-coach-af64d).
# Usage: scripts/set-secret NAME   then paste the value (hidden) and press Enter.
# First run creates the secret; later runs add a new version (for key rotation).
# The value is never echoed and never lands in shell history; no trailing newline is stored.
set -euo pipefail
name="${1:?usage: scripts/set-secret NAME}"
gc="$(dirname "$0")/gc"
read -r -s -p "Value for $name (hidden): " value; echo
[ -n "$value" ] || { echo "Empty value, nothing stored." >&2; exit 1; }
if "$gc" secrets describe "$name" >/dev/null 2>&1; then
  printf '%s' "$value" | "$gc" secrets versions add "$name" --data-file=-
else
  printf '%s' "$value" | "$gc" secrets create "$name" --replication-policy=automatic --data-file=-
fi
echo "Stored $name ($(printf '%s' "$value" | wc -c | tr -d ' ') characters)."
